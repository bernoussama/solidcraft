[
  {"note": "#36: one Preferences dialog, from the gear at the top right (and Ctrl+,). Changes apply at once; Cancel puts them back, OK keeps them."},
  {"click": {"handle": "titlebar:preferences"}},
  {"expect": {"shown": "Restore Defaults", "prefs": {"dialog": "General", "theme": "dark", "dark": true, "mcp_http_enabled": false, "mcp_http_port": 7879}}},
  {"expect": {"shown": "Listen for MCP clients over HTTP"}},
  {"click": {"handle": "prefs:theme"}},
  {"click": {"handle": "prefs:theme:light"}},
  {"expect": {"prefs": {"theme": "light", "dark": false}}},
  {"widget": "Cancel"},
  {"expect": {"not_shown": "Restore Defaults", "prefs": {"dialog": null, "theme": "dark", "dark": true}}},
  {"note": "Ctrl+, opens it again; the shortcuts page is in the same dialog."},
  {"key": "Comma", "cmd": true},
  {"expect": {"prefs": {"dialog": "General"}}},
  {"widget": "Keyboard Shortcuts"},
  {"expect": {"shown": "Reset All", "prefs": {"dialog": "Keyboard Shortcuts"}}},
  {"widget": "Navigation"},
  {"widget": "Fusion"},
  {"widget": "Tinkercad"},
  {"expect": {"prefs": {"nav": "tinkercad"}}},
  {"widget": "Design"},
  {"widget": "Y up"},
  {"expect": {"prefs": {"up_axis": "y", "dialog": "Design"}}},
  {"widget": "OK"},
  {"expect": {"not_shown": "Restore Defaults", "prefs": {"up_axis": "y", "dialog": null}}}
]
